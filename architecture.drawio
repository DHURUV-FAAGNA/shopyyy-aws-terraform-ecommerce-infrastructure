<mxfile host="app.diagrams.net"><diagram name="Shopyyy Architecture" id="shopyyy-arch"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws" value="AWS Cloud  (region: variable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="1215" height="1000" as="geometry"/></mxCell><mxCell id="vpc" value="VPC  (CIDR from variable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#555555;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="110" width="880" height="930" as="geometry"/></mxCell><mxCell id="azA" value="Availability Zone A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="150" width="410" height="870" as="geometry"/></mxCell><mxCell id="azB" value="Availability Zone B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="410" height="870" as="geometry"/></mxCell><mxCell id="pubA" value="Public subnet A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e6;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="185" width="390" height="160" as="geometry"/></mxCell><mxCell id="pubB" value="Public subnet B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4e6;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="185" width="390" height="160" as="geometry"/></mxCell><mxCell id="prvA" value="Private subnet A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3edff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="365" width="390" height="640" as="geometry"/></mxCell><mxCell id="prvB" value="Private subnet B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3edff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="365" width="390" height="640" as="geometry"/></mxCell><mxCell id="user" value="User Browser&lt;br&gt;https://shopyyy.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="190" height="70" as="geometry"/></mxCell><mxCell id="r53" value="Route 53&lt;br&gt;hosted zone shopyyy.com&lt;br&gt;(alias A/AAAA to CloudFront)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9b3;strokeColor=#d6b656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="210" height="80" as="geometry"/></mxCell><mxCell id="cf" value="AMAZON CLOUDFRONT (CDN)&lt;br&gt;HTTPS only, HTTP redirected&lt;br&gt;Default  /*    -&gt;  S3&lt;br&gt;/api/*  -&gt;  ALB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd966;strokeColor=#b8860b;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="260" height="130" as="geometry"/></mxCell><mxCell id="s3" value="S3 Bucket&lt;br&gt;React static files (HTML/CSS/JS)&lt;br&gt;private, Origin Access Control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="205" width="260" height="85" as="geometry"/></mxCell><mxCell id="acm" value="ACM Certificates&lt;br&gt;shopyyy.com + *.shopyyy.com&lt;br&gt;DNS validated (Route 53)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9b3;strokeColor=#d6b656;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="620" width="260" height="85" as="geometry"/></mxCell><mxCell id="sm" value="Secrets Manager&lt;br&gt;RDS DB credentials, injected into&lt;br&gt;ECS tasks at start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="760" width="260" height="80" as="geometry"/></mxCell><mxCell id="alb" value="Application Load Balancer  (HTTPS 443, health check /api/health)&lt;br&gt;SG: alb-sg   in 443 from CloudFront prefix list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#3c6aa8;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="205" width="760" height="62" as="geometry"/></mxCell><mxCell id="nat" value="NAT Gateway  (ECS outbound 443)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="285" width="300" height="45" as="geometry"/></mxCell><mxCell id="ecsA" value="ECS Fargate API task #1&lt;br&gt;port 3000   SG: ecs-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="300" height="65" as="geometry"/></mxCell><mxCell id="redis" value="ElastiCache Redis (single node)&lt;br&gt;cache.t3.micro :6379   SG: redis-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="520" width="300" height="65" as="geometry"/></mxCell><mxCell id="mskA" value="MSK Kafka broker 1  :9092&lt;br&gt;SG: msk-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="300" height="65" as="geometry"/></mxCell><mxCell id="rdsA" value="RDS PostgreSQL 17 PRIMARY&lt;br&gt;db.t3.medium :5432   SG: rds-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="760" width="300" height="65" as="geometry"/></mxCell><mxCell id="ecsB" value="ECS Fargate API task #2&lt;br&gt;port 3000   SG: ecs-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="400" width="330" height="65" as="geometry"/></mxCell><mxCell id="mskB" value="MSK Kafka broker 2  :9092&lt;br&gt;SG: msk-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="520" width="330" height="65" as="geometry"/></mxCell><mxCell id="wrk" value="Order Worker (ECS service)&lt;br&gt;Kafka consumer   SG: ecs-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="640" width="330" height="65" as="geometry"/></mxCell><mxCell id="rdsB" value="RDS PostgreSQL STANDBY&lt;br&gt;(Multi-AZ, synchronous replica)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="760" width="330" height="65" as="geometry"/></mxCell><mxCell id="flow" value="REQUEST FLOW&lt;br&gt;1  Browser asks Route 53 for&lt;br&gt;    shopyyy.com&lt;br&gt;2  Route 53 returns CloudFront;&lt;br&gt;    browser connects over HTTPS&lt;br&gt;3a  /*  -&gt; CloudFront serves the&lt;br&gt;    React files from private S3&lt;br&gt;3b  /api/* -&gt; CloudFront forwards&lt;br&gt;    to the ALB (secret header)&lt;br&gt;4  ALB -&gt; healthy Fargate task :3000&lt;br&gt;5a  API checks Redis cache first&lt;br&gt;5b  Cache miss -&gt; query RDS&lt;br&gt;    (result cached in Redis)&lt;br&gt;6  Order placed -&gt; API publishes&lt;br&gt;    message to Kafka (MSK)&lt;br&gt;7  Worker consumes the message&lt;br&gt;8  Worker saves/updates order in RDS&lt;br&gt;9  Response returns the same path&lt;br&gt;&lt;br&gt;Both API tasks use Redis, RDS&lt;br&gt;and MSK (one task per AZ)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="235" height="505" as="geometry"/></mxCell><mxCell id="e0" value="1  DNS lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="user" target="r53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="alias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;dashed=1;" edge="1" parent="1" source="r53" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2  HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="user" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="TLS cert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;dashed=1;" edge="1" parent="1" source="acm" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="3a  /*  static files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="cf" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="3b  /api/*  + X-Origin-Verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="cf" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4  :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="alb" target="ecsA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="4  :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="alb" target="ecsB"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="7  consume :9092" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="mskB" target="wrk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="8  save order :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="wrk" target="rdsB"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="sync replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;dashed=1;" edge="1" parent="1" source="rdsA" target="rdsB"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b0" value="5a  :6379" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecsA" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="5b  :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecsA" target="rdsA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b2" value="6  :9092" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecsA" target="mskA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;SECURITY GROUPS (who can talk to whom)&lt;/b&gt;&lt;br&gt;ALB SG: in 443 from CloudFront managed prefix list | out 3000 to ECS SG&lt;br&gt;ECS SG: in 3000 from ALB SG | out 5432 to RDS SG, 6379 to Redis SG, 9092 to MSK SG, 443 to internet via NAT&lt;br&gt;RDS SG: in 5432 from ECS SG only | Redis SG: in 6379 from ECS SG only | MSK SG: in 9092 from ECS SG only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#fffbe6;strokeColor=#d6b656;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1075" width="1440" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>